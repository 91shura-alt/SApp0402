<Page x:Class="SellerOps.App.Views.SuppliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SuppliesPage">

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
            <Button x:Name="ImportBtn"
                    Content="Импорт из Excel..."
                    Height="40"
                    Margin="0,0,0,12"
                    Click="ImportBtn_Click"/>

            <TextBlock Text="Поставки"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <ListBox x:Name="SuppliesList"
                     MinHeight="300"
                     DisplayMemberPath="Number"
                     SelectedValuePath="Id"
                     SelectionChanged="SuppliesList_SelectionChanged"/>

            <Button x:Name="DeleteBtn"
                    Content="Удалить выбранную"
                    Background="#E5555B"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Height="44"
                    Margin="0,12,0,0"
                    Click="DeleteBtn_Click"/>
        </StackPanel>

        <!-- Кнопка «Сканер» -->
        <Button x:Name="ScannerBtn"
                Grid.Column="2"
                Grid.Row="0"
                Content="Сканер"
                Height="40"
                Width="520"
                HorizontalAlignment="Center"
                Click="ScannerBtn_Click"/>

        <!-- Правая часть: поиск + таблица + подвал -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Поиск -->
                <RowDefinition Height="*"/>
                <!-- Таблица -->
                <RowDefinition Height="Auto"/>
                <!-- Подвал -->
            </Grid.RowDefinitions>

            <!-- Панель поиска -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Width="260"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown">
                    <TextBox.ToolTip>Поиск (Ctrl+F)…</TextBox.ToolTip>
                </TextBox>

                <Button x:Name="ClearSearchBtn"
                        Content="Очистить"
                        Click="ClearSearchBtn_Click"
                        VerticalAlignment="Center"/>

                <TextBlock x:Name="SearchInfo"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Таблица позиций выбранной поставки -->
            <DataGrid x:Name="ItemsGrid"
          Grid.Row="1"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          RowHeaderWidth="0"
          Margin="0,0,6,0"
          SelectionUnit="Cell"
          SelectionMode="Extended"
          ClipboardCopyMode="ExcludeHeader"
          PreviewKeyDown="ItemsGrid_PreviewKeyDown">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- Ожидает — без выделения (никаких сеттеров) -->

                            <DataTrigger Binding="{Binding [Статус]}" Value="Собран частично">
                                <Setter Property="Background" Value="#FFFFF4CC"/>
                                <!-- светло-жёлтый -->
                            </DataTrigger>

                            <DataTrigger Binding="{Binding [Статус]}" Value="Собран">
                                <Setter Property="Background" Value="#FFE8FFE8"/>
                                <!-- светло-зелёный -->
                            </DataTrigger>

                            <DataTrigger Binding="{Binding [Статус]}" Value="Отгружен частично">
                                <Setter Property="Background" Value="#FFFFE6F0"/>
                                <!-- светло-розовый -->
                            </DataTrigger>

                            <DataTrigger Binding="{Binding [Статус]}" Value="Отгружен">
                                <Setter Property="Background" Value="#FFE6F4FF"/>
                                <!-- светло-голубой -->
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Resources>
                    <ContextMenu x:Key="CellContextMenu">
                        <MenuItem Header="Копировать" Click="CopyCell_Click"/>
                    </ContextMenu>
                    <Style TargetType="DataGridCell">
                        <Setter Property="ContextMenu" Value="{StaticResource CellContextMenu}"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>


            <!-- Подвал с суммами -->
            <Border Grid.Row="2"
                    Background="#FFF8F8F8"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{x:Null}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="Итого: " FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTotal" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <TextBlock Text="Собрано: " FontWeight="Bold"/>
                            <TextBlock x:Name="TxtPicked" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Остаток: " FontWeight="Bold"/>
                            <TextBlock x:Name="TxtRemain" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
