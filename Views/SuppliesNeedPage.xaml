<Page x:Class="SellerOps.App.Views.SuppliesNeedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF8F9FB">

    <Grid>
        <Border CornerRadius="16" Background="White" Padding="24" Margin="40"
                Effect="{DynamicResource Drop}">
            <StackPanel>
                <TextBlock Text="Расчёт потребности"
                           FontSize="22" FontWeight="SemiBold" Foreground="#23272F"/>

                <TextBlock Text="Здесь появится алгоритм расчёта потребности по плану и остаткам."
                           Margin="0,12,0,0" Foreground="#566074"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Назад" Width="100" Height="32" Margin="0,0,8,0"
                            Click="Back_Click" Background="#EEF1F6" Foreground="#23272F"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <Page.Resources>
        <DropShadowEffect x:Key="Drop" BlurRadius="12" ShadowDepth="0" Opacity="0.10"/>
    </Page.Resources>
</Page>
