<Page x:Class="SellerOps.App.Views.CommonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="WB Common">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="← Назад" Click="Back_Click" Width="100" Margin="0,0,12,0"/>
            <TextBlock Text="WB Common" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Width="15"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <TabItem Header="Продавец (seller-info)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Обновить из WB" Click="RefreshSellerInfo_Click" Height="32" Width="150" Margin="0,0,12,0"/>
                            <Button Content="Показать JSON" Click="ShowSellerRaw_Click" Height="32" Width="130"/>
                        </StackPanel>

                        <GroupBox Header="Ключи (коротко):" Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="SellerSummaryBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="120"/>
                        </GroupBox>

                        <Expander x:Name="SellerRawExpander" Header="JSON" IsExpanded="False" Grid.Row="2">
                            <TextBox x:Name="SellerRawBox"
                                     FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Height="380"/>
                        </Expander>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Новости WB">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Обновить" Click="RefreshNews_Click" Height="32" Width="120" Margin="0,0,12,0"/>
                        <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
                        <TextBox x:Name="NewsQueryBox" Width="260" Margin="8,0,0,0" TextChanged="NewsQueryBox_TextChanged"/>
                        <Button Content="Показать JSON" Click="ShowNewsRaw_Click" Height="32" Width="140" Margin="12,0,0,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="NewsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionChanged="NewsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Dt}" Width="160"/>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="Текст новости:" FontWeight="Bold" Margin="0,10,0,6"/>
                    <TextBox Grid.Row="3"
                             x:Name="NewsBodyBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Height="140"/>

                    <Expander Grid.Row="4" x:Name="NewsRawExpander" Header="JSON" IsExpanded="False" Margin="0,10,0,0">
                        <TextBox x:Name="NewsRawBox"
                                 FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Height="260"/>
                    </Expander>

                </Grid>
            </TabItem>

        </TabControl>

    </Grid>
</Page>
