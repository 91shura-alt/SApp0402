<Page x:Class="SellerOps.App.Views.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Товары">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="260" Margin="0,0,8,0"/>
            <Button Content="Найти" Click="Search_Click" Margin="0,0,8,0" Width="100"/>
            <Button Content="Обновить из WB" Click="Sync_Click" Margin="0,0,8,0" Width="140"/>
            <Button Content="Импорт себестоимости" Click="ImportCost_Click" Margin="0,0,8,0" Width="170"/>
            <Button Content="Открыть логи" Click="OpenLogs_Click" Width="120"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="ProductsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="All"
                  GridLinesVisibility="All"
                  SnapsToDevicePixels="True"

                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  ClipboardCopyMode="ExcludeHeader">

            <!-- Горячая клавиша Ctrl+C -->
            <DataGrid.InputBindings>
                <KeyBinding Modifiers="Control" Key="C" Command="Copy" />
            </DataGrid.InputBindings>

            <!-- Контекстное меню -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать" Command="Copy" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- nmID -> Артикул WB -->
                <DataGridTextColumn Header="Артикул WB"
                                    Binding="{Binding NmId}"
                                    Width="140" />

                <!-- Название КЛИКАБЕЛЬНОЕ -->
                <DataGridTemplateColumn Header="Название" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="Blue"
                                       TextDecorations="Underline"
                                       Cursor="Hand"
                                       ToolTip="Открыть карточку"
                                       MouseLeftButtonUp="TitleCell_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Бренд"
                                    Binding="{Binding Brand}"
                                    Width="180" />

                <DataGridTextColumn Header="Предмет"
                                    Binding="{Binding Subject}"
                                    Width="220" />

                <!-- VendorCode -> Артикул поставщика -->
                <DataGridTextColumn Header="Артикул поставщика"
                                    Binding="{Binding VendorCode}"
                                    Width="200" />
                <!-- Объём, м3 -->
                <DataGridTextColumn Header="Объём, м³"
                    Binding="{Binding VolumeM3, StringFormat=0.######}"
                    Width="120" />

                <!-- Себестоимость -->
                <DataGridTextColumn Header="Себестоимость"
                    Binding="{Binding Cost, StringFormat={}{0:N2}}"
                    Width="120" />
                <DataGridTextColumn Header="Штрихкод"
                                    Binding="{Binding Barcode}"
                                    Width="200" />

                <DataGridTextColumn Header="Синхронизировано"
                                    Binding="{Binding SyncedAt, StringFormat=g}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
