<Page x:Class="SellerOps.App.Views.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Карточка товара">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                <Button Content="← Назад" Click="Back_Click" Width="100" Margin="0,0,12,0"/>
                <TextBlock x:Name="TitleBlock" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Основной блок -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,18,6" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Артикул WB:" FontWeight="Bold"/>
                        <TextBox x:Name="NmIdBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Бренд:" FontWeight="Bold"/>
                        <TextBox x:Name="BrandBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Предмет:" FontWeight="Bold"/>
                        <TextBox x:Name="SubjectBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Артикул поставщика:" FontWeight="Bold"/>
                        <TextBox x:Name="VendorCodeBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Штрихкоды:" FontWeight="Bold"/>
                        <TextBox x:Name="BarcodesBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Архив:" FontWeight="Bold"/>
                        <TextBox x:Name="ArchivedBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Габариты упаковки (Д×Ш×В), см:" FontWeight="Bold"/>
                        <TextBox x:Name="DimsBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Вес с упаковкой, кг:" FontWeight="Bold"/>
                        <TextBox x:Name="WeightBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,6" Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Объём, м³:" FontWeight="Bold"/>
                        <TextBox x:Name="VolumeBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                    </Grid>

                    <Grid Margin="0,0,18,0" Grid.Row="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Описание:" FontWeight="Bold"/>
                        <TextBox x:Name="DescBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="260"/>
                    </Grid>
                </Grid>

                <!-- Правая колонка -->
                <StackPanel Grid.Column="1">
                    <GroupBox Header="Характеристики (attributes)" Margin="0,0,0,12">
                        <DataGrid x:Name="CharGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="220"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Цены и скидки" Margin="0,0,0,12">
                        <DataGrid x:Name="PricesGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="100"/>
                                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                                <DataGridTextColumn Header="Цена со скидкой" Binding="{Binding DiscountedPrice}" Width="130"/>
                                <DataGridTextColumn Header="Клубная цена" Binding="{Binding ClubPrice}" Width="120"/>
                                <DataGridTextColumn Header="Скидка продавца, %" Binding="{Binding SellerDiscount}" Width="130"/>
                                <DataGridTextColumn Header="Скидка WB клуба, %" Binding="{Binding ClubDiscount}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Акции и требуемые скидки">
                        <DataGrid x:Name="PromotionsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Акция" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Требуемая скидка, %" Binding="{Binding RequiredDiscount}" Width="150"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Комментарий" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Календарь акций WB" Margin="0,12,0,0">
                        <DataGrid x:Name="CalendarPromotionsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Акция" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Дата с" Binding="{Binding DateFrom}" Width="140"/>
                                <DataGridTextColumn Header="Дата по" Binding="{Binding DateTo}" Width="140"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Участие" Binding="{Binding Participation}" Width="120"/>
                                <DataGridTextColumn Header="Комментарий" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!-- Сырый JSON -->
            <Expander Header="Показать исходный JSON карточки" Grid.Row="2" Margin="0,8,0,0">
                <TextBox x:Name="RawJsonBox" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" Height="320" IsReadOnly="True"/>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
