<Page x:Class="SellerOps.App.Views.WbSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="WB Настройки">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <Button Content="← Назад" Click="Back_Click" Width="100"/>
        </DockPanel>

        <!-- Контент -->
        <StackPanel Grid.Row="1" MaxWidth="820">
            <TextBlock Text="База данных" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="Полный путь к файлу .db" Margin="0,0,0,4"/>
            <TextBox x:Name="DbPathBox" Margin="0,0,0,8" TextChanged="DbPathBox_TextChanged"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Выбрать файл базы" Click="SelectDbPath_Click" Width="180" Margin="0,0,8,0"/>
                <Button Content="Открыть папку" Click="OpenDbFolder_Click" Width="140" Margin="0,0,8,0"/>
                <Button Content="Сохранить путь" Click="SaveDbPath_Click" Width="140"/>
            </StackPanel>

            <TextBlock x:Name="DbPathWarningText"
                       Foreground="DarkOrange"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"
                       Text="Внимание: путь внутри облачного диска. Не запускайте приложение одновременно на двух ПК."/>

            <TextBlock Text="Период по умолчанию (дней)" Margin="0,0,0,4"/>
            <TextBox x:Name="DefaultPeriodDaysBox" Margin="0,0,0,16" TextChanged="DefaultPeriodDaysBox_TextChanged"/>

            <CheckBox x:Name="PlainTokensBox"
                      Content="Хранить токены без шифрования (для работы на двух ПК)"
                      Margin="0,0,0,8"
                      Checked="PlainTokensBox_Toggled"
                      Unchecked="PlainTokensBox_Toggled"/>

            <TextBlock Text="Режим без шифрования позволяет переносить токены между ПК, но снижает безопасность."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Токены WB API" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Категория" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CategoryBox" Width="220">
                    <ComboBoxItem Content="Content" IsSelected="True"/>
                    <ComboBoxItem Content="Statistics"/>
                    <ComboBoxItem Content="Analytics"/>

                    <ComboBoxItem Content="Marketplace"/>
                    <ComboBoxItem Content="PricesAndDiscounts"/>

                    <ComboBoxItem Content="Promotion"/>
                    <ComboBoxItem Content="Feedbacks"/>
                    <ComboBoxItem Content="BuyerChat"/>
                    <ComboBoxItem Content="Supplies"/>
                    <ComboBoxItem Content="Returns"/>

                    <ComboBoxItem Content="Documents"/>
                    <ComboBoxItem Content="Finance"/>

                    <ComboBoxItem Content="Users"/>
                    <ComboBoxItem Content="Common"/>
                </ComboBox>

                <CheckBox x:Name="SandboxBox" Content="Sandbox" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Название токена (опционально)" Margin="0,8,0,2"/>
            <TextBox x:Name="AliasBox" Margin="0,0,0,8"/>

            <TextBlock Text="Supplier ID (опционально, если у вас несколько поставщиков)" Margin="0,8,0,2"/>
            <TextBox x:Name="SupplierIdBox" Margin="0,0,0,8" ToolTip="Например: 170896"/>

            <TextBlock Text="API-токен" Margin="0,8,0,2"/>
            <PasswordBox x:Name="TokenBox" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Сохранить" Click="Save_Click" Width="140" Margin="0,0,8,0"/>
                <Button Content="Проверить доступ" Click="Test_Click" Width="160" Margin="0,0,8,0"/>
                <Button Content="Удалить выбранный" Click="Delete_Click" Width="160"/>
            </StackPanel>

            <DataGrid x:Name="TokensGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      Margin="0,16,0,0"
                      Height="360">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Alias" Binding="{Binding Alias}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Sandbox" Binding="{Binding IsSandbox}" Width="80"/>
                    <DataGridTextColumn Header="SupplierId" Binding="{Binding SupplierId}" Width="100"/>
                    <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAtUtc}" Width="160"/>
                    <DataGridTextColumn Header="EncryptedToken" Binding="{Binding EncryptedToken}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap">
                Подсказка: при синхронизации используется последний сохранённый токен нужной категории (по Id).
                Чтобы сделать другой «активным», просто сохраните его заново или удалите лишние.
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
